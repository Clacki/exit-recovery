{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/currentProject/[projectId]",
      "regex": "^/currentProject/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprojectId": "nxtPprojectId"
      },
      "namedRegex": "^/currentProject/(?<nxtPprojectId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/exited/[projectId]",
      "regex": "^/exited/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprojectId": "nxtPprojectId"
      },
      "namedRegex": "^/exited/(?<nxtPprojectId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/exiter/[userId]",
      "regex": "^/exiter/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPuserId": "nxtPuserId"
      },
      "namedRegex": "^/exiter/(?<nxtPuserId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/exiting/[projectId]",
      "regex": "^/exiting/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprojectId": "nxtPprojectId"
      },
      "namedRegex": "^/exiting/(?<nxtPprojectId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/exiting/[projectId]/edit",
      "regex": "^/exiting/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPprojectId": "nxtPprojectId"
      },
      "namedRegex": "^/exiting/(?<nxtPprojectId>[^/]+?)/edit(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/exited",
      "regex": "^/exited(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/exited(?:/)?$"
    },
    {
      "page": "/exiter/userList",
      "regex": "^/exiter/userList(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/exiter/userList(?:/)?$"
    },
    {
      "page": "/exiting",
      "regex": "^/exiting(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/exiting(?:/)?$"
    },
    {
      "page": "/exiting/write",
      "regex": "^/exiting/write(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/exiting/write(?:/)?$"
    },
    {
      "page": "/myPage",
      "regex": "^/myPage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/myPage(?:/)?$"
    },
    {
      "page": "/myPage/edit",
      "regex": "^/myPage/edit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/myPage/edit(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}